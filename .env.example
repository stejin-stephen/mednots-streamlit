# Medical Note Summarizer - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# OpenAI Configuration (REQUIRED)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
AI_INTEGRATIONS_OPENAI_API_KEY=sk-proj-your-api-key-here

# OpenAI API base URL (optional, defaults to official OpenAI API)
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# Database Configuration (REQUIRED)
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# 
# Examples:
#   Local: postgresql://postgres:password@localhost:5432/medical_notes
#   Neon: postgresql://user:pass@ep-cool-name-123.us-east-2.aws.neon.tech/medical_notes
#   Supabase: postgresql://postgres:pass@db.project.supabase.co:5432/postgres
DATABASE_URL=postgresql://username:password@localhost:5432/medical_notes

# Individual PostgreSQL connection parameters (optional if using DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGDATABASE=medical_notes
PGUSER=postgres
PGPASSWORD=your-password-here

# ============================================
# Application Configuration (OPTIONAL)
# ============================================
# Session secret for Streamlit (generate a random string)
SESSION_SECRET=your-random-secret-key-here

# ============================================
# Instructions
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit the .env file to version control
# 4. The .env file is already listed in .gitignore
